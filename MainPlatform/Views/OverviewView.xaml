            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- 日志控制台（实时日志） -->
            <Border Grid.Column="0" Style="{StaticResource LogConsole}" Margin="0,0,6,0" Padding="0">
                <local:LogViewerControl Height="200"/>
            </Border>
            <!-- 线弧信息 -->
            <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="6,0,0,0" Padding="12,10">
