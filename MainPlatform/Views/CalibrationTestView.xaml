<UserControl x:Class="MainPlatform.Views.CalibrationTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="900"
             Background="#F2F5F9">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MainPlatform;component/Styles/ParameterPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 运动参数 -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Style="{StaticResource SectionTitle}">
                    <Border Style="{StaticResource SectionTitleBar}"/>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="运动参数"/>
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Style="{StaticResource ParamLabel}" Text="焊接速度:" Width="76"/>
                        <TextBox Style="{StaticResource ParamInput}" Text="200"/>
                        <TextBlock Style="{StaticResource ParamUnit}" Text="%"/>
                        <TextBlock Style="{StaticResource ParamRange}" Text="(5~500)"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Style="{StaticResource ParamLabel}" Text="断丝速度:" Width="76"/>
                        <TextBox Style="{StaticResource ParamInput}" Text="10"/>
                        <TextBlock Style="{StaticResource ParamUnit}" Text="%"/>
                        <TextBlock Style="{StaticResource ParamRange}" Text="(5~1000)"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Style="{StaticResource ParamLabel}" Text="留尾模式:" Width="76"/>
                        <ComboBox Style="{StaticResource PComboBox}" ItemContainerStyle="{StaticResource PComboBoxItem}" SelectedIndex="0">
                            <ComboBoxItem Content="线夹"/>
                            <ComboBoxItem Content="气流"/>
                            <ComboBoxItem Content="关闭"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Style="{StaticResource ParamLabel}" Text="打火速度:" Width="76"/>
                        <TextBox Style="{StaticResource ParamInput}" Text="300"/>
                        <TextBlock Style="{StaticResource ParamUnit}" Text="%"/>
                        <TextBlock Style="{StaticResource ParamRange}" Text="(0~1000)"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Style="{StaticResource ParamLabel}" Text="加热功率:" Width="76"/>
                        <TextBox Style="{StaticResource ParamInput}" Text="0"/>
                        <TextBlock Style="{StaticResource ParamUnit}" Text="%"/>
                        <TextBlock Style="{StaticResource ParamRange}" Text="(0~100)"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 校准操作 -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Style="{StaticResource SectionTitle}">
                    <Border Style="{StaticResource SectionTitleBar}"/>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="校准操作"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 第一行 -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CalibButton}" Margin="4" Content="{Binding HorizontalLockText}" Background="{Binding HorizontalLockBrush}" cal:Message.Attach="LockHorizontal"/>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CalibButton}" Margin="4" Content="{Binding VerticalLockText}" Background="{Binding VerticalLockBrush}" cal:Message.Attach="LockVertical"/>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CalibButton}" Content="力校准" Margin="4" cal:Message.Attach="ForceCalibrate"/>
                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource CalibButton}" Content="力测试" Margin="4" cal:Message.Attach="ForceTest"/>
                    <!-- 第二行 -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CalibButton}" Content="超声校准" Margin="4"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CalibButton}" Content="初始化" Margin="4"/>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CalibButton}" Content="序列号" Margin="4"/>
                </Grid>
                <!-- 校准状态（扩展） -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ForceCalibrationBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ForceCalibrationText}" Foreground="#4B5563" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#2FA84F" VerticalAlignment="Center"/>
                            <TextBlock Text="超声校准: 已完成" Foreground="#4B5563" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#F0A500" VerticalAlignment="Center"/>
                            <TextBlock Text="序列号: 未配置" Foreground="#4B5563" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 操作栏 -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" Padding="12,8" BorderBrush="#E5E8EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="恢复默认" Margin="0,0,8,0"/>
                <Button Style="{StaticResource ActionButton}" Content="保存参数"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
