<Window x:Class="MainPlatform.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:MainPlatform.Views"
        xmlns:vm="clr-namespace:MainPlatform.ViewModels"
        xmlns:conv="clr-namespace:MainPlatform.Converters"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:cal="http://www.caliburnproject.org"
        mc:Ignorable="d"
        Title="登录" Height="768" Width="1024"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0B1220" FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#0D1726"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#0D1726"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧品牌与设备信息区 -->
            <Border Grid.Column="0" Background="#101B2B">
                <Grid ClipToBounds="True">
                    <Ellipse Width="460" Height="460" Fill="#0EA5E9" Opacity="0.08"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-160,0,0"/>
                    <Ellipse Width="300" Height="300" Fill="#2563EB" Opacity="0.10"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-100"/>

                    <StackPanel VerticalAlignment="Center" Margin="80,0,60,0">
                        <Border Width="184" Height="84" CornerRadius="2" Background="White" Padding="9" HorizontalAlignment="Left">
                            <Image Source="/Resources/Images/SCMC_Logo.png" Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="键合机上位机软件" Foreground="#F8FAFC" FontSize="30" FontWeight="Bold"
                                   Margin="0,26,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Equipment Host Control Platform" Foreground="#64748B" FontSize="13"
                                   Margin="0,10,0,0"/>

                        <Border Width="72" Height="3" Background="#2563EB" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="0,30,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                            <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center"/>
                            <TextBlock Text="系统就绪 · 高精度 · 高可靠 · 智能化" Foreground="#38BDF8" FontSize="13"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧登录表单区 -->
            <Border Grid.Column="1" Background="#0F1B2D">
                <Grid Margin="64,40">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="用户登录" Foreground="#F8FAFC" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="USER LOGIN" Foreground="#475569" FontSize="11" Margin="0,8,0,0"/>

                        <StackPanel Margin="0,40,0,0">
                            <TextBlock Text="用户名" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource LoginTextBox}"
                                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="密码" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"/>
                            <Grid>
                                <PasswordBox Style="{StaticResource LoginPasswordBox}"/>
                                <TextBox Style="{StaticResource LoginTextBox}"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <ToggleButton IsChecked="{Binding IsPasswordVisible}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Margin="0,0,10,0" Background="Transparent"
                                              BorderThickness="0" Foreground="#64748B" Cursor="Hand">
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                </ToggleButton>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <CheckBox Content="记住密码" IsChecked="{Binding IsRemembered, Mode=TwoWay}"
                                      Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            <Button Content="注册账号" Foreground="#38BDF8" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Right" Cursor="Hand" />
                        </Grid>

                        <Button Content="登 录" Style="{StaticResource LoginButton}" Margin="0,26,0,0" cal:Message.Attach="Login"
                                />
                        <TextBlock Text="提示：使用你的用户名和密码登录。" Foreground="#475569" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,22,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#22C55E"/>
                    <TextBlock Text="系统就绪" Foreground="#94A3B8" FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="v1.0.0  ·  SECS/GEM Ready" Foreground="#475569" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>


