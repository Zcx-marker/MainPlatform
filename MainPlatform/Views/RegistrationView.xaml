<Window x:Class="MainPlatform.Views.RegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MainPlatform.ViewModels"
        xmlns:conv="clr-namespace:MainPlatform.Converters"
        xmlns:cal="http://www.caliburnproject.org"
        d:DataContext="{d:DesignInstance Type=vm:RegistrationViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Title="用户注册" Height="620" Width="780"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#F2F5F9" Foreground="#1F2329"
        FontFamily="Microsoft YaHei UI" FontSize="14">

    <Window.Resources>
        <!-- ============ 输入框 ============ -->
        <Style x:Key="RegInput" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2329" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#C0C8D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E5AA8" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 密码框 ============ -->
        <Style x:Key="RegPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2329" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#C0C8D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E5AA8" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 下拉框 ============ -->
        <Style x:Key="RegComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2329" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#C0C8D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False" />
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="#6B7A8C" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#FFFFFF" BorderBrush="#D5DCE3" BorderThickness="1"
                                        CornerRadius="5" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E5AA8" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RegComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1F2329" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF2FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE3EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 注册按钮（主色蓝） ============ -->
        <Style x:Key="RegPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="30,0" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1E5AA8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F6DB5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#174A8A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 取消按钮（浅灰） ============ -->
        <Style x:Key="RegGhostButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="30,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#E9EEF4" />
            <Setter Property="Foreground" Value="#1F2329" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D5DCE3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE3EA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C9D2DC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 返回按钮 ============ -->
        <Style x:Key="RegBackButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EEF4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 居中白色卡片 -->
        <Border Width="680" Height="548" Background="#FFFFFF" CornerRadius="12"
                BorderBrush="#D5DCE3" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="52,36,52,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 + 返回 -->
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="用户注册" Foreground="#1F2329" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="USER REGISTRATION" Foreground="#6B7A8C" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Content="&#x3C;&#x3C;" Style="{StaticResource RegBackButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            cal:Message.Attach="Cancel" ToolTip="返回" />
                </Grid>

                <!-- 表单 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,0">
                    <!-- 用户名 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="用户名 *" Foreground="#4B5563" FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource RegInput}"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="20" ToolTip="3~20 位字母、数字或下划线" />
                    </Grid>
                    <!-- 密码 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="密 码 *" Foreground="#4B5563" FontSize="14"
                                   VerticalAlignment="Center" />
                        <PasswordBox Grid.Column="1" Style="{StaticResource RegPassword}" MaxLength="20"
                                     conv:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     conv:PasswordBoxHelper.IsMonitoring="True"
                                     ToolTip="6~20 位字符" />
                    </Grid>
                    <!-- 确认密码 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="确认密码 *" Foreground="#4B5563" FontSize="14"
                                   VerticalAlignment="Center" />
                        <PasswordBox Grid.Column="1" Style="{StaticResource RegPassword}" MaxLength="20"
                                     conv:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     conv:PasswordBoxHelper.IsMonitoring="True" />
                    </Grid>
                    <!-- 手机号 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="手机号" Foreground="#4B5563" FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource RegInput}"
                                 Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="11" ToolTip="选填，11 位手机号" />
                    </Grid>
                    <!-- 用户角色 -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="用户角色" Foreground="#4B5563" FontSize="14"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Style="{StaticResource RegComboBox}"
                                  ItemContainerStyle="{StaticResource RegComboBoxItem}"
                                  ItemsSource="{Binding IdentityList}"
                                  SelectedItem="{Binding SelectedIdentity, Mode=TwoWay}"
                                  DisplayMemberPath="Key">
                        </ComboBox>
                    </Grid>

                    <!-- 错误提示 -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#D93026" FontSize="13"
                               Margin="110,12,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 底部按钮 -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Border Height="1" Background="#E5E8EB" Margin="0,0,0,18" VerticalAlignment="Top" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="注 册" Style="{StaticResource RegPrimaryButton}"
                                cal:Message.Attach="Register" />
                        <Button Content="取 消" Style="{StaticResource RegGhostButton}"
                                cal:Message.Attach="Cancel" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
