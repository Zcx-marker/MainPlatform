<UserControl x:Class="MainPlatform.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="580" d:DesignWidth="900"
             Background="#F2F5F9">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MainPlatform;component/Styles/ParameterPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="14,10">
        <!-- 主体：顺序号文件绑定管理 -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="10,10,10,0" >
            <StackPanel>
                <!-- 顶部：当前顺序号文件路径 + 另存为 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="顺序号文件：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="D:/wbs_para/完整ku8参数.ini" FontSize="13" Foreground="#1F2329"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="另存为"
                            Height="32" Padding="16,0"/>
                </Grid>

                <!-- 绑定列表 -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E8EB" BorderThickness="1" Padding="12,8">
                    <StackPanel>
                        <!-- 列表头 -->
                        <Grid Margin="4,0,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="序号" FontSize="11" Foreground="#6B7A8C" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="绑定文件" FontSize="11" Foreground="#6B7A8C" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="操作" FontSize="11" Foreground="#6B7A8C" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- 序号0 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号0：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="D:/wbs_para/bond_para.csv" FontSize="13" Foreground="#2E3A45" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0"/>
                            </Grid>
                        </Border>
                        <!-- 序号1 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号1：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="D:/wbs_para/bond_parab.csv" FontSize="13" Foreground="#2E3A45" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0"/>
                            </Grid>
                        </Border>
                        <!-- 序号2 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号2：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="D:/wbs_para/duan450.csv" FontSize="13" Foreground="#2E3A45" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0"/>
                            </Grid>
                        </Border>
                        <!-- 序号3 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号3：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="D:/wbs_para/chang.csv" FontSize="13" Foreground="#2E3A45" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0"/>
                            </Grid>
                        </Border>
                        <!-- 序号4 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号4：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="-" FontSize="13" Foreground="#8A94A3" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0" IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <!-- 序号5 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号5：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="-" FontSize="13" Foreground="#8A94A3" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0" IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <!-- 序号6 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号6：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="-" FontSize="13" Foreground="#8A94A3" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0" IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <!-- 序号7 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号7：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="-" FontSize="13" Foreground="#8A94A3" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0" IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <!-- 序号8 -->
                        <Border Background="#FFFFFF" BorderBrush="#E5E8EB" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="序号8：" FontSize="13" Foreground="#4B5563" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="-" FontSize="13" Foreground="#8A94A3" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="解绑" Height="26" FontSize="11" Padding="6,0" Margin="4,0" IsEnabled="False"/>
                            </Grid>
                        </Border>
                   
                    </StackPanel>
                </Border>

                <!-- 解绑所有 -->
                <Button Style="{StaticResource GhostButton}" Content="解绑所有" Height="30" FontSize="12"
                        Padding="0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
