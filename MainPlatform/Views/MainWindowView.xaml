<Window x:Class="MainPlatform.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:local="clr-namespace:MainPlatform.Views"
        xmlns:vms="clr-namespace:MainPlatform.ViewModels"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        d:DataContext="{d:DesignInstance Type=vms:MainWindowViewModel, IsDesignTimeCreatable=True}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Height="768"
        Width="1024"
        ResizeMode="NoResize"
        Background="#F2F5F9"
        Foreground="#1F2329"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

    <Window.Resources>
        <!-- ============ 左侧一级导航大按钮 ============ -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1E5AA8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Grid>
                                <Border Width="4" Height="26" Background="#1E5AA8" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" x:Name="Ind" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E0E6ED"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 当前选中的一级菜单 -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1E5AA8" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 底部页签按钮 ============ -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Menu.IsSelected}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#E9EEF4"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 当前选中的页签 -->
                <DataTrigger Binding="{Binding Menu.IsSelected}" Value="True">
                    <Setter Property="Background" Value="#1E5AA8" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 顶部工具按钮 ============ -->
        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#E9EEF4" />
            <Setter Property="Foreground" Value="#1F2329" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D5DCE3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE3EA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部工具栏 ==================== -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D5DCE3" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：Logo + 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="152" Height="64" Background="Transparent" CornerRadius="4" Padding="1" BorderBrush="Transparent" BorderThickness="1">
                        <Image Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Fant"
                               SnapsToDevicePixels="True">
                            <Image.Source>
                                <!-- 按显示尺寸 2 倍解码（304px），避免 995px 原图一次缩小 8 倍导致采样糊 -->
                                <BitmapImage UriSource="/Resources/Images/SCMC_Logo_RL.png"
                                             DecodePixelWidth="304"
                                             CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" FontSize="20" FontWeight="Bold" Foreground="#1F2329" />
                        <TextBlock Text="{Binding AppSubTitle}" FontSize="12" Foreground="#6B7A8C" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 中：程序信息 + 操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#F5F7FA" CornerRadius="6" Padding="16,7" BorderBrush="#D5DCE3" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="程序：" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecipeName}" Foreground="#1E5AA8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="　顺序号：" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SequenceNo}" Foreground="#1E5AA8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Content="打开程序" Style="{StaticResource TopButtonStyle}" cal:Message.Attach="OpenRecipe" />
                    <Button Content="另存程序" Style="{StaticResource TopButtonStyle}" cal:Message.Attach="SaveRecipeAs" />
                    <Button Content="统计" Style="{StaticResource TopButtonStyle}" cal:Message.Attach="ShowStatistics" />
                </StackPanel>

                <!-- 右：用户 + 前进后退 + 退出 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#2FA84F" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DisplayUserName}" Foreground="#4B5563" FontSize="13.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Border Width="1" Height="24" Background="#E5E8EB" Margin="16,0" />
                    <!--<Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="44"
                            Width="48" Style="{StaticResource TopButtonStyle}" cal:Message.Attach="GoBackAsync" 
                            IsEnabled="{Binding CanGoBack}" ToolTip="后退" />
                    <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="20" Height="44"
                            Width="48" Style="{StaticResource TopButtonStyle}" cal:Message.Attach="GoForwardAsync"
                            IsEnabled="{Binding CanGoForward}" ToolTip="前进" />-->
                    <Button Content="退出登录" Style="{StaticResource TopButtonStyle}" Foreground="#D93026"
                            cal:Message.Attach="LogoutAsync" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主区域 ==================== -->
        <Grid Grid.Row="1">

            <!-- 主内容区：左侧导航 + 页面内容 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧一级导航（竞品布局：三个固定大按钮均分填满左侧高度） -->
                <Border Grid.Column="0" Background="#E9EEF4" BorderBrush="#D5DCE3" BorderThickness="0,0,1,0">
                    <Grid Margin="0,12,0,12">
                        <ItemsControl ItemsSource="{Binding Menus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding MenuCount}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button cal:Message.Attach="SelectMenu($dataContext)"
                                        cal:Action.TargetWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource MenuButtonStyle}">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="26" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayName}" FontSize="20"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap" Width="25"
                                                   Margin="0,10,0,0" TextAlignment="Center"
                                                   LineHeight="26" LineStackingStrategy="BlockLineHeight" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- 内容区：页面内容 + 底部页签 -->
                <Grid Grid.Column="1" Background="#F2F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <!-- 页面内容 -->
                    <ContentControl Grid.Row="0" cal:View.Model="{Binding CurrentTab.Screen}" Margin="5"  />

                    <!-- 底部页签（对应竞品：焊点参数/弧形参数/尾丝球形参数…） -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D5DCE3" BorderThickness="0,1,0,0">
                        <ItemsControl ItemsSource="{Binding Pages}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding SubMeanuCount}" HorizontalAlignment="Stretch" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button cal:Message.Attach="SelectTab($dataContext)"
                                        cal:Action.TargetWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource TabButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 底部状态栏（竞品：自动/线夹/超声/打火/坐标/时间） ==================== -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D5DCE3" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#2FA84F" VerticalAlignment="Center" />
                    <TextBlock Text="自动" Foreground="#4B5563" FontSize="12.5" Margin="10,0,0,0" />
                    <TextBlock Text="线夹关" Foreground="#4B5563" FontSize="12.5" Margin="14,0,0,0" />
                    <TextBlock Text="超声正常" Foreground="#4B5563" FontSize="12.5" Margin="14,0,0,0" />
                    <TextBlock Text="打火正常" Foreground="#4B5563" FontSize="12.5" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Foreground="#6B7A8C" FontSize="12.5">
                        <Run Text="X: " /><Run Text="{Binding MachineX, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="#6B7A8C" FontSize="12.5" Margin="12,0,0,0">
                        <Run Text="Y: " /><Run Text="{Binding MachineY, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="#6B7A8C" FontSize="12.5" Margin="12,0,0,0">
                        <Run Text="Z: " /><Run Text="{Binding MachineZ, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="　·　" Foreground="#8A94A3" FontSize="12.5" />
                    <TextBlock Text="{Binding CurrentTime}" Foreground="#6B7A8C" FontSize="12.5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
