<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         工控浅色主题（白纸黑字）
         覆盖 HandyControl 皮肤资源键，使整个软件呈现：
         白色/浅灰背景 + 近黑文字 + 工控蓝强调 + 高对比清晰可读
         ===================================================================== -->

    <!-- ========== 颜色资源（覆盖 HandyControl 标准色键） ========== -->
    <Color x:Key="PrimaryColor">#1E5AA8</Color>
    <Color x:Key="PrimaryLightColor">#3A78C4</Color>
    <Color x:Key="PrimaryDarkColor">#174A8A</Color>
    <Color x:Key="DangerColor">#D93026</Color>
    <Color x:Key="LightDangerColor">#FDE9E8</Color>
    <Color x:Key="DarkDangerColor">#B5231A</Color>
    <Color x:Key="WarningColor">#E6A23C</Color>
    <Color x:Key="LightWarningColor">#FDF6E8</Color>
    <Color x:Key="DarkWarningColor">#C97F12</Color>
    <Color x:Key="InfoColor">#1783B4</Color>
    <Color x:Key="LightInfoColor">#E8F4FA</Color>
    <Color x:Key="DarkInfoColor">#0F6E9C</Color>
    <Color x:Key="SuccessColor">#2FA84F</Color>
    <Color x:Key="LightSuccessColor">#EAF7EE</Color>
    <Color x:Key="DarkSuccessColor">#1F8A3E</Color>
    <Color x:Key="AccentColor">#1E5AA8</Color>
    <Color x:Key="DarkAccentColor">#174A8A</Color>
    <Color x:Key="DefaultColor">#FFFFFF</Color>
    <Color x:Key="DarkDefaultColor">#F5F7FA</Color>
    <Color x:Key="BackgroundColor">#F2F5F9</Color>
    <Color x:Key="RegionColor">#FFFFFF</Color>
    <Color x:Key="SecondaryRegionColor">#F2F5F9</Color>
    <Color x:Key="ThirdlyRegionColor">#FFFFFF</Color>
    <Color x:Key="TitleColor">#1F2329</Color>
    <Color x:Key="SecondaryTitleColor">#1E5AA8</Color>
    <Color x:Key="PrimaryTextColor">#1F2329</Color>
    <Color x:Key="SecondaryTextColor">#4B5563</Color>
    <Color x:Key="ThirdlyTextColor">#6B7A8C</Color>
    <Color x:Key="ReverseTextColor">#FFFFFF</Color>
    <Color x:Key="TextIconColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D5DCE3</Color>
    <Color x:Key="SecondaryBorderColor">#AAB4C0</Color>
    <Color x:Key="DarkMaskColor">#33000000</Color>
    <Color x:Key="DarkOpacityColor">#40000000</Color>

    <!-- ========== 画刷资源（HandyControl 控件模板引用的标准键） ========== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="LightDangerBrush" Color="{StaticResource LightDangerColor}"/>
    <SolidColorBrush x:Key="DarkDangerBrush" Color="{StaticResource DarkDangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="LightWarningBrush" Color="{StaticResource LightWarningColor}"/>
    <SolidColorBrush x:Key="DarkWarningBrush" Color="{StaticResource DarkWarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="LightInfoBrush" Color="{StaticResource LightInfoColor}"/>
    <SolidColorBrush x:Key="DarkInfoBrush" Color="{StaticResource DarkInfoColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="LightSuccessBrush" Color="{StaticResource LightSuccessColor}"/>
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="{StaticResource DarkSuccessColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccentColor}"/>

    <!-- 表面 / 区域 -->
    <SolidColorBrush x:Key="DefaultBackgroundBrush" Color="{StaticResource DefaultColor}"/>
    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}"/>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}"/>
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdlyRegionColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource RegionColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource RegionColor}"/>
    <SolidColorBrush x:Key="ColorBrush" Color="{StaticResource DefaultColor}"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TitleColor}"/>
    <SolidColorBrush x:Key="SecondaryTitleBrush" Color="{StaticResource SecondaryTitleColor}"/>
    <SolidColorBrush x:Key="DefaultForegroundBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdlyTextColor}"/>
    <SolidColorBrush x:Key="ReverseTextBrush" Color="{StaticResource ReverseTextColor}"/>
    <SolidColorBrush x:Key="TextIconBrush" Color="{StaticResource TextIconColor}"/>

    <!-- 边框 / 分割线 -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource SecondaryBorderColor}"/>

    <!-- 滚动条等其它常用资源 -->
    <SolidColorBrush x:Key="ScrollBarBackground" Color="#F2F5F9"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B8C2CC"/>
    <SolidColorBrush x:Key="ScrollBarHoverBrush" Color="#9AA8B6"/>

</ResourceDictionary>
